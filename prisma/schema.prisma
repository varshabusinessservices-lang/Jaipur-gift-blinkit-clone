// ==========================================
// WALLET & REWARDS SYSTEM
// ==========================================

model WalletAccount {
  id                     String    @id @default(uuid()) @db.Char(36)
  customerId             String    @unique @db.Char(36)
  status                 String    @default("ACTIVE") // ACTIVE, BLOCKED
  currency               String    @default("INR")
  version                Int       @default(0)
  cachedTotalBalance     Decimal   @default(0.00) @db.Decimal(12, 2)
  cachedAvailableBalance Decimal   @default(0.00) @db.Decimal(12, 2)
  cachedHeldBalance      Decimal   @default(0.00) @db.Decimal(12, 2)
  lastReconciledAt       DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  customer             Customer                    @relation(fields: [customerId], references: [id])
  creditLots           WalletCreditLot[]
  ledgerEntries        WalletLedgerEntry[]
  reservations         WalletReservation[]
  topUps               WalletTopUp[]
  adjustments          WalletAdjustmentRequest[]
  fraudSignals         WalletFraudSignal[]
  riskAssessments      WalletRiskAssessment[]
  reconciliationIssues WalletReconciliationIssue[]

  @@map("wallet_accounts")
}

model WalletCreditLot {
  id                           String    @id @default(uuid()) @db.Char(36)
  walletAccountId              String    @db.Char(36)
  customerId                   String?   @db.Char(36)
  bucketType                   String // SELF_LOADED, REWARD, REFERRAL_REFERRER, REFERRAL_NEW_USER, REFUND, PROMOTIONAL, LOCKED_OR_HELD
  originalAmount               Decimal   @db.Decimal(12, 2)
  remainingAmount              Decimal   @db.Decimal(12, 2)
  reservedAmount               Decimal   @default(0.00) @db.Decimal(12, 2)
  consumedAmount               Decimal   @default(0.00) @db.Decimal(12, 2)
  reversedAmount               Decimal   @default(0.00) @db.Decimal(12, 2)
  expiredAmount                Decimal   @default(0.00) @db.Decimal(12, 2)
  currency                     String    @default("INR")
  sourceType                   String // TOP_UP, REWARD_CONVERSION, REFERRAL_REWARD, REFUND, ADMIN_PROMO
  sourceId                     String?   @db.Char(36)
  creditedAt                   DateTime  @default(now())
  availableAt                  DateTime  @default(now())
  expiresAt                    DateTime?
  expiryAtReservationTime      DateTime?
  protectedReservedAmount      Decimal   @default(0.00) @db.Decimal(12, 2)
  postReleaseExpiryRequired    Boolean   @default(false)
  firstOrderOverrideConsumedAt DateTime?
  status                       String    @default("ACTIVE") // ACTIVE, EXHAUSTED, EXPIRED, REVOKED, LOCKED
  priority                     Int       @default(0) // Higher number = used first
  firstOrderOnly               Boolean   @default(false)
  metadataJson                 String?   @db.Text
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  walletAccount    WalletAccount                 @relation(fields: [walletAccountId], references: [id])
  allocations      WalletReservationAllocation[]
  orderAllocations OrderPaymentAllocation[]

  @@index([walletAccountId])
  @@index([bucketType])
  @@index([status])
  @@index([expiresAt])
  @@index([walletAccountId, status, expiresAt])
  @@index([walletAccountId, bucketType, status, expiresAt])
  @@index([sourceType, sourceId])
  @@map("wallet_credit_lots")
}

model WalletLedgerEntry {
  id                      String   @id @default(uuid()) @db.Char(36)
  walletAccountId         String   @db.Char(36)
  customerId              String?  @db.Char(36)
  creditLotId             String?  @db.Char(36)
  reservationId           String?  @db.Char(36)

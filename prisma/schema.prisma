  campaignId              String?   @db.Char(36)
  metadataJson            String?   @db.Text
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@index([normalisedCode])
  @@index([customerId, status])
  @@index([validUntil])
  @@index([campaignId])
  @@map("referral_codes")
}

model ReferralAttributionSession {
  id                    String    @id @default(uuid()) @db.Char(36)
  tokenHash             String    @unique
  referralCodeId        String?   @db.Char(36)
  referrerCustomerId    String    @db.Char(36)
  prospectiveMobileHash String?
  prospectiveEmailHash  String?
  deviceId              String?
  sessionId             String?
  ipHash                String?
  status                String    @default("PENDING") // PENDING, ATTACHED, EXPIRED, REJECTED, CANCELLED
  attachedCustomerId    String?   @db.Char(36)
  attachedAt            DateTime?
  rejectedAt            DateTime?
  rejectionReason       String?   @db.Text
  metadataJson          String?   @db.Text
  expiresAt             DateTime
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([status, expiresAt])
  @@index([tokenHash])
  @@index([referralCodeId])
  @@index([referrerCustomerId])
  @@map("referral_attribution_sessions")
}

model ReferralReviewCase {
  id                     String    @id @default(uuid()) @db.Char(36)
  referralRelationshipId String    @db.Char(36)
  referrerCustomerId     String    @db.Char(36)
  newCustomerId          String    @db.Char(36)
  riskAssessmentId       String?   @db.Char(36)
  status                 String    @default("OPEN") // OPEN, PENDING_REVIEW, APPROVED, REJECTED, MORE_INFORMATION_REQUIRED, FRAUD_HOLD, RESOLVED, CLOSED
  priority               String    @default("MEDIUM") // LOW, MEDIUM, HIGH, CRITICAL
  riskScore              Int       @default(0)
  triggeredSignals       String?   @db.Text
  reasonCode             String?
  assignedTo             String?   @db.Char(36)
  reviewerNotes          String?   @db.Text
  decision               String?
  reviewedBy             String?   @db.Char(36)
  reviewedAt             DateTime?
  resolvedAt             DateTime?
  metadataJson           String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, priority, createdAt])
  @@index([referralRelationshipId])
  @@index([assignedTo])
  @@map("referral_review_cases")
}

model ReferralRecoveryCase {
  id                     String    @id @default(uuid()) @db.Char(36)
  referralRelationshipId String    @db.Char(36)
  referralCreditId       String?   @db.Char(36)
  walletCreditLotId      String?   @db.Char(36)
  orderId                String?   @db.Char(36)
  refundId               String?   @db.Char(36)
  recoveryType           String // NEW_USER_CREDIT_FAILED, REFERRER_CREDIT_FAILED, DUPLICATE_CREDIT_ATTEMPT, CREDIT_ALREADY_SPENT, PARTIAL_REVERSAL, etc.
  status                 String    @default("OPEN") // OPEN, RETRY_PENDING, AUTO_RECOVERY, MANUAL_REVIEW, RESOLVED, FAILED, CLOSED
  originalAmount         Decimal   @db.Decimal(12, 2)
  recoverableAmount      Decimal   @db.Decimal(12, 2)
  recoveredAmount        Decimal   @default(0.00) @db.Decimal(12, 2)
  outstandingAmount      Decimal   @db.Decimal(12, 2)
  reasonCode             String?
  retryCount             Int       @default(0)
  nextRetryAt            DateTime?
  assignedTo             String?   @db.Char(36)
  resolution             String?   @db.Text
  detectedAt             DateTime  @default(now())
  resolvedAt             DateTime?
  metadataJson           String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([status, nextRetryAt])
  @@index([referralRelationshipId])
  @@map("referral_recovery_cases")
}

model ReferralReconciliationRun {
  id                   String    @id @default(uuid()) @db.Char(36)
  runType              String // AUTOMATED_DAILY, MANUAL, ON_DEMAND
  status               String    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED, COMPLETED_WITH_DISCREPANCIES, FAILED
  startedAt            DateTime  @default(now())
  completedAt          DateTime?
  relationshipsScanned Int       @default(0)
  creditsScanned       Int       @default(0)
  lotsScanned          Int       @default(0)
  matchedCount         Int       @default(0)
  mismatchedCount      Int       @default(0)
  repairedCount        Int       @default(0)
  escalatedCount       Int       @default(0)
  summaryJson          String?   @db.Text
  initiatedBy          String?   @default("SYSTEM")
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  issues ReferralReconciliationIssue[]

  @@map("referral_reconciliation_runs")
}

model ReferralReconciliationIssue {
  id                     String    @id @default(uuid()) @db.Char(36)
  reconciliationRunId    String    @db.Char(36)
  referralRelationshipId String?   @db.Char(36)
  customerId             String?   @db.Char(36)
  issueType              String // DUPLICATE_RELATIONSHIP, MISSING_NEW_USER_CREDIT, MISSING_REFERRER_CREDIT, DUPLICATE_CREDIT, MISSING_WALLET_LOT, INVALID_QUALIFICATION, OVERRIDE_MISMATCH, etc.
  expectedAmount         Decimal   @default(0.00) @db.Decimal(12, 2)
  actualAmount           Decimal   @default(0.00) @db.Decimal(12, 2)
  differenceAmount       Decimal   @default(0.00) @db.Decimal(12, 2)
  status                 String    @default("OPEN") // OPEN, RESOLVED, MANUAL_REVIEW, IGNORED
  resolution             String?   @db.Text
  resolvedBy             String?   @db.Char(36)
  detectedAt             DateTime  @default(now())
  resolvedAt             DateTime?
  metadataJson           String?   @db.Text

  run ReferralReconciliationRun @relation(fields: [reconciliationRunId], references: [id])

  @@index([reconciliationRunId])
  @@index([status])
  @@map("referral_reconciliation_issues")
}

model ReferralNotificationEvent {
  id                     String    @id @default(uuid()) @db.Char(36)
  customerId             String    @db.Char(36)
  referralRelationshipId String?   @db.Char(36)
  referralCreditId       String?   @db.Char(36)
  eventType              String // JOINED, NEW_USER_CREDIT_ISSUED, FIRST_ORDER_DELIVERED, COOLING_STARTED, REFERRER_REWARDED, EXPIRY_REMINDER, REVERSAL
  channel                String    @default("IN_APP") // IN_APP, EMAIL, SMS, PUSH
  recipientContact       String?
  status                 String    @default("PENDING") // PENDING, SENT, FAILED, READ, CANCELLED
  idempotencyKey         String?   @unique
  scheduledFor           DateTime  @default(now())
  sentAt                 DateTime?
  readAt                 DateTime?
  failureReason          String?   @db.Text
  metadataJson           String?   @db.Text
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  @@index([customerId, status])
  @@index([scheduledFor])
  @@map("referral_notification_events")
}

model CustomerDeviceLink {

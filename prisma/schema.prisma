  product   Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([addonId])
  @@index([productId])
  @@index([variationId])
  @@index([categoryId])
  @@index([assignmentType])
  @@index([status])
  @@map("addon_assignments")
}

model AddonGroup {
  id                String                  @id @default(uuid()) @db.Char(36)
  storeId           String?                 @db.Char(36)
  name              String
  slug              String                  @unique
  description       String?                 @db.Text
  selectionType     AddonGroupSelectionType
  minimumSelections Int                     @default(0)
  maximumSelections Int?
  isRequired        Boolean                 @default(false)
  status            ProductAddonStatus      @default(ACTIVE)
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  store Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items AddonGroupItem[]

  @@index([status])
  @@index([sortOrder])
  @@map("addon_groups")
}

model AddonGroupItem {
  id        String   @id @default(uuid()) @db.Char(36)
  groupId   String   @db.Char(36)
  addonId   String   @db.Char(36)
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group AddonGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addon ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([groupId, addonId])
  @@index([groupId])
  @@index([addonId])
  @@index([sortOrder])
  @@map("addon_group_items")
}


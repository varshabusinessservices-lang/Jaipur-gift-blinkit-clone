model ProductAddon {
  id                String                  @id @default(uuid()) @db.Char(36)
  storeId           String?                 @db.Char(36)
  name              String
  slug              String                  @unique
  code              String?
  shortDescription  String?                 @db.Text
  description       String?                 @db.Text
  inputType         ProductAddonInputType
  pricingType       ProductAddonPricingType
  fixedPrice        Decimal?                @db.Decimal(12, 2)
  percentageRate    Decimal?                @db.Decimal(7, 4)
  minimumAmount     Decimal?                @db.Decimal(12, 2)
  maximumAmount     Decimal?                @db.Decimal(12, 2)
  defaultAmount     Decimal?                @db.Decimal(12, 2)
  taxRateId         String?                 @db.Char(36)
  priceIncludesTax  Boolean                 @default(true)
  imageFileId       String?                 @db.Char(36)
  status            ProductAddonStatus      @default(ACTIVE)
  isRequired        Boolean                 @default(false)
  allowQuantity     Boolean                 @default(false)
  minimumQuantity   Int                     @default(0)
  maximumQuantity   Int?
  defaultQuantity   Int?
  manageStock       Boolean                 @default(false)
  stockQuantity     Int?
  reservedStock     Int                     @default(0)
  lowStockThreshold Int?
  allowBackorder    Boolean                 @default(false)
  placeholder       String?
  helpText          String?                 @db.Text
  validationJson    String?                 @db.Text
  customerLabel     String?
  internalLabel     String?
  sortOrder         Int                     @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  createdByAdminId  String?                 @db.Char(36)
  updatedByAdminId  String?                 @db.Char(36)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  store       Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  taxRate     TaxRate?             @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  options     ProductAddonOption[]
  assignments AddonAssignment[]
  groupItems  AddonGroupItem[]

  @@index([status])
  @@index([storeId])
  @@index([inputType])
  @@index([pricingType])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([startsAt])
  @@index([endsAt])
  @@map("product_addons")
}

model ProductAddonOption {
  id             String                   @id @default(uuid()) @db.Char(36)
  addonId        String                   @db.Char(36)
  name           String
  code           String?
  description    String?                  @db.Text
  pricingType    ProductAddonPricingType?
  fixedPrice     Decimal?                 @db.Decimal(12, 2)
  percentageRate Decimal?                 @db.Decimal(7, 4)

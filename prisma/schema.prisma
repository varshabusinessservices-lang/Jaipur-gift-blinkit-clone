enum ProductAddonStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
  SCHEDULED
}

enum ProductAddonInputType {
  CHECKBOX
  RADIO
  DROPDOWN
  QUANTITY
  TEXT
  TEXTAREA
  SINGLE_IMAGE
  MULTI_IMAGE
  FILE
  NUMBER
}

enum ProductAddonPricingType {
  FIXED
  PERCENTAGE
  FREE
  PER_QUANTITY
  CUSTOM_AMOUNT
}

enum AddonAssignmentType {
  GLOBAL
  ALL_PERSONALISED_PRODUCTS
  CATEGORY
  PRODUCT
  VARIATION
}

enum AddonAssignmentStatus {
  ACTIVE
  INACTIVE
}

enum AddonGroupSelectionType {
  SINGLE
  MULTIPLE
}

model ProductAddon {
  id                String                  @id @default(uuid()) @db.Char(36)
  storeId           String?                 @db.Char(36)
  name              String
  slug              String                  @unique
  code              String?
  shortDescription  String?                 @db.Text
  description       String?                 @db.Text
  inputType         ProductAddonInputType
  pricingType       ProductAddonPricingType
  fixedPrice        Decimal?                @db.Decimal(12, 2)
  percentageRate    Decimal?                @db.Decimal(7, 4)
  minimumAmount     Decimal?                @db.Decimal(12, 2)
  maximumAmount     Decimal?                @db.Decimal(12, 2)
  defaultAmount     Decimal?                @db.Decimal(12, 2)
  taxRateId         String?                 @db.Char(36)
  priceIncludesTax  Boolean                 @default(true)
  imageFileId       String?                 @db.Char(36)
  status            ProductAddonStatus      @default(ACTIVE)
  isRequired        Boolean                 @default(false)
  allowQuantity     Boolean                 @default(false)
  minimumQuantity   Int                     @default(0)
  maximumQuantity   Int?
  defaultQuantity   Int?
  manageStock       Boolean                 @default(false)
  stockQuantity     Int?
  reservedStock     Int                     @default(0)
  lowStockThreshold Int?
  allowBackorder    Boolean                 @default(false)
  placeholder       String?
  helpText          String?                 @db.Text
  validationJson    String?                 @db.Text
  customerLabel     String?
  internalLabel     String?
  sortOrder         Int                     @default(0)
  startsAt          DateTime?
  endsAt            DateTime?
  createdByAdminId  String?                 @db.Char(36)
  updatedByAdminId  String?                 @db.Char(36)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  store       Store?               @relation(fields: [storeId], references: [id], onDelete: SetNull)
  taxRate     TaxRate?             @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  options     ProductAddonOption[]
  assignments AddonAssignment[]
  groupItems  AddonGroupItem[]

  @@index([status])
  @@index([storeId])
  @@index([inputType])
  @@index([pricingType])
  @@index([sortOrder])
  @@index([deletedAt])
  @@index([startsAt])
  @@index([endsAt])
  @@map("product_addons")
}

model ProductAddonOption {
  id             String                   @id @default(uuid()) @db.Char(36)
  addonId        String                   @db.Char(36)
  name           String
  code           String?
  description    String?                  @db.Text
  pricingType    ProductAddonPricingType?
  fixedPrice     Decimal?                 @db.Decimal(12, 2)
  percentageRate Decimal?                 @db.Decimal(7, 4)
  imageFileId    String?                  @db.Char(36)
  isDefault      Boolean                  @default(false)
  status         ProductAddonStatus       @default(ACTIVE)
  sortOrder      Int                      @default(0)
  metadataJson   String?                  @db.Text
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt
  deletedAt      DateTime?

  addon ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@index([addonId])
  @@index([status])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("product_addon_options")
}

model AddonAssignment {
  id                 String                @id @default(uuid()) @db.Char(36)
  addonId            String                @db.Char(36)
  assignmentType     AddonAssignmentType
  productId          String?               @db.Char(36)
  variationId        String?               @db.Char(36)
  categoryId         String?               @db.Char(36)
  isRequiredOverride Boolean?
  priceOverride      Decimal?              @db.Decimal(12, 2)
  percentageOverride Decimal?              @db.Decimal(7, 4)
  sortOrder          Int                   @default(0)
  startsAt           DateTime?
  endsAt             DateTime?
  status             AddonAssignmentStatus @default(ACTIVE)
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  addon     ProductAddon      @relation(fields: [addonId], references: [id], onDelete: Cascade)
  product   Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variation ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)
  category  Category?         @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@index([addonId])
  @@index([productId])
  @@index([variationId])
  @@index([categoryId])
  @@index([assignmentType])
  @@index([status])
  @@map("addon_assignments")
}

model AddonGroup {
  id                String                  @id @default(uuid()) @db.Char(36)
  storeId           String?                 @db.Char(36)
  name              String
  slug              String                  @unique
  description       String?                 @db.Text
  selectionType     AddonGroupSelectionType
  minimumSelections Int                     @default(0)
  maximumSelections Int?
  isRequired        Boolean                 @default(false)
  status            ProductAddonStatus      @default(ACTIVE)
  sortOrder         Int                     @default(0)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  store Store?           @relation(fields: [storeId], references: [id], onDelete: SetNull)
  items AddonGroupItem[]

  @@index([status])
  @@index([sortOrder])
  @@map("addon_groups")
}

model AddonGroupItem {
  id        String   @id @default(uuid()) @db.Char(36)
  groupId   String   @db.Char(36)
  addonId   String   @db.Char(36)
  sortOrder Int      @default(0)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  group AddonGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  addon ProductAddon @relation(fields: [addonId], references: [id], onDelete: Cascade)

  @@unique([groupId, addonId])
  @@index([groupId])
  @@index([addonId])
  @@index([sortOrder])
  @@map("addon_group_items")
}

enum CustomerStatus {

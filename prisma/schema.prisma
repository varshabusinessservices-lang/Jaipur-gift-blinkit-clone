// ==========================================
// APPEARANCE & THEME ENGINE
// ==========================================

model Theme {
  id          String    @id @default(uuid()) @db.Char(36)
  name        String
  status      String    @default("DRAFT") // DRAFT, PUBLISHED, ARCHIVED
  isActive    Boolean   @default(false)
  version     Int       @default(1)
  settings    String    @db.Text // Global styles JSON
  createdBy   String?
  updatedBy   String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  pages    ThemePage[]
  versions ThemeVersion[]

  @@map("themes")
}

model ThemePage {
  id        String   @id @default(uuid()) @db.Char(36)
  themeId   String   @db.Char(36)
  pageType  String // HOMEPAGE, PRODUCT, CATEGORY, CUSTOM
  route     String?
  status    String   @default("ACTIVE")
  settings  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  theme    Theme          @relation(fields: [themeId], references: [id], onDelete: Cascade)
  sections ThemeSection[]

  @@index([themeId])
  @@map("theme_pages")
}

model ThemeSection {
  id             String    @id @default(uuid()) @db.Char(36)
  themePageId    String    @db.Char(36)
  sectionType    String // HERO, ICON_CATEGORIES, PRODUCT_SLIDER, BANNER, AUDIENCE, OFFERS, STORIES, HIGHLIGHTS, TEXT
  title          String?
  subtitle       String?
  position       Int       @default(0)
  enabled        Boolean   @default(true)
  desktopEnabled Boolean   @default(true)
  tabletEnabled  Boolean   @default(true)
  mobileEnabled  Boolean   @default(true)
  settings       String?   @db.Text // JSON configuration
  styleSettings  String?   @db.Text // JSON styles
  contentSource  String? // MANUAL, CATEGORY, BESTSELLER, NEW
  startAt        DateTime?
  endAt          DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  page  ThemePage          @relation(fields: [themePageId], references: [id], onDelete: Cascade)
  items ThemeSectionItem[]

  @@index([themePageId])
  @@map("theme_sections")
}

model ThemeSectionItem {
  id             String   @id @default(uuid()) @db.Char(36)
  sectionId      String   @db.Char(36)
  itemType       String? // SLIDE, CATEGORY, PRODUCT, BANNER
  title          String?
  subtitle       String?
  imageUrl       String?
  mobileImageUrl String?
  linkUrl        String?
  position       Int      @default(0)
  enabled        Boolean  @default(true)
  settings       String?  @db.Text // JSON per-item settings
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  section ThemeSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  @@index([sectionId])
  @@map("theme_section_items")
}

model ThemeVersion {
  id        String   @id @default(uuid()) @db.Char(36)
  themeId   String   @db.Char(36)
  version   Int
  snapshot  String   @db.Text // Full JSON representation of theme, pages, sections, items
  createdBy String?
  createdAt DateTime @default(now())

  theme Theme @relation(fields: [themeId], references: [id], onDelete: Cascade)

  @@index([themeId])
  @@map("theme_versions")
}

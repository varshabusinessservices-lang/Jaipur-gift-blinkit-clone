  description  String?       @db.Text
  metadataJson String?       @db.Text
  createdAt    DateTime      @default(now())

  returnRequest ReturnRequest @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_timelines")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Char(36)
  eventType     String
  aggregateType String
  aggregateId   String    @db.Char(36)
  storeId       String?   @db.Char(36)
  customerId    String?   @db.Char(36)
  actorId       String?   @db.Char(36)
  correlationId String?   @db.Char(36)
  causationId   String?   @db.Char(36)
  payload       String    @db.Text
  status        String    @default("PENDING") // PENDING, PROCESSING, PROCESSED, FAILED, DEAD_LETTER
  attempts      Int       @default(0)
  nextAttemptAt DateTime?
  lockedAt      DateTime?
  processedAt   DateTime?
  lastError     String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([status])
  @@index([eventType])
  @@index([nextAttemptAt])
  @@map("outbox_events")
}

model Notification {
  id                String       @id @default(uuid()) @db.Char(36)
  notificationNumber String      @unique
  eventId           String?      @db.Char(36)
  recipientType     String       // CUSTOMER, STAFF, ADMIN
  recipientId       String?      @db.Char(36)
  customerId        String?      @db.Char(36)
  staffId           String?      @db.Char(36)
  channel           String       // EMAIL, SMS, WHATSAPP, PUSH, IN_APP
  category          String       // AUTHENTICATION, ORDER, PAYMENT, PRODUCTION, DELIVERY, RETURN, REFUND, REPLACEMENT, SUPPORT, SECURITY, SYSTEM
  templateId        String?      @db.Char(36)
  renderedSubject   String?
  renderedBody      String       @db.Text
  renderedPayload   String?      @db.Text
  status            String       @default("QUEUED") // QUEUED, PROCESSING, SENT, DELIVERED, READ, FAILED, DEAD_LETTER, CANCELLED, SKIPPED
  priority          String       @default("NORMAL") // LOW, NORMAL, HIGH, CRITICAL
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  failedAt          DateTime?
  readAt            DateTime?
  provider          String?
  providerMessageId String?
  attempts          Int          @default(0)
  idempotencyKey    String       @unique
  lastError         String?      @db.Text
  metadataJson      String?      @db.Text
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  attemptsList      NotificationDeliveryAttempt[]

  @@index([customerId])
  @@index([staffId])
  @@index([status])
  @@index([channel])
  @@index([idempotencyKey])
  @@map("notifications")
}

model NotificationTemplate {
  id                  String   @id @default(uuid()) @db.Char(36)
  code                String   // e.g. ORDER_PLACED_EMAIL
  name                String
  channel             String   // EMAIL, SMS, WHATSAPP, PUSH, IN_APP
  category            String   // ORDER, etc.
  locale              String   @default("en")
  subjectTemplate     String?
  bodyTemplate        String   @db.Text
  payloadTemplate     String?  @db.Text
  version             Int      @default(1)
  isActive            Boolean  @default(true)
  isDefault           Boolean  @default(false)
  variablesSchemaJson String?  @db.Text
  providerTemplateName String?
  providerTemplateId  String?
  approvalStatus      String   @default("APPROVED") // APPROVED, PENDING, REJECTED
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  deletedAt           DateTime?

  @@index([code, channel, locale])
  @@map("notification_templates")
}

model EventNotificationRule {
  id            String   @id @default(uuid()) @db.Char(36)
  eventType     String
  channel       String   // EMAIL, SMS, WHATSAPP, PUSH, IN_APP
  recipientRule String   // CUSTOMER, STAFF, ADMIN
  templateCode  String
  priority      String   @default("NORMAL")
  isEnabled     Boolean  @default(true)
  delaySeconds  Int      @default(0)
  conditionsJson String? @db.Text
  storeScope    String?
  locale        String   @default("en")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([eventType, isEnabled])
  @@map("event_notification_rules")
}

model NotificationPreference {
  id             String   @id @default(uuid()) @db.Char(36)
  customerId     String   @db.Char(36)
  category       String   // ORDER, PAYMENT, etc.
  emailEnabled   Boolean  @default(true)
  smsEnabled     Boolean  @default(true)
  whatsappEnabled Boolean @default(true)
  pushEnabled    Boolean  @default(true)
  inAppEnabled   Boolean  @default(true)
  consentSource  String   @default("CHECKOUT")
  optedInAt      DateTime @default(now())
  optedOutAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([customerId, category])
  @@index([customerId])
  @@map("notification_preferences")
}

model DeviceRegistration {
  id          String    @id @default(uuid()) @db.Char(36)
  userId      String?   @db.Char(36)
  customerId  String?   @db.Char(36)
  staffId     String?   @db.Char(36)
  deviceId    String
  platform    String    // ANDROID, IOS, WEB
  pushToken   String    @db.Text
  appVersion  String?
  deviceName  String?
  isActive    Boolean   @default(true)
  lastSeenAt  DateTime  @default(now())
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([customerId])
  @@index([staffId])
  @@index([deviceId])
  @@map("device_registrations")
}

model NotificationDeliveryAttempt {
  id             String       @id @default(uuid()) @db.Char(36)
  notificationId String       @db.Char(36)
  channel        String
  provider       String?
  status         String       // SUCCESS, FAILED
  requestPayload String?      @db.Text
  responsePayload String?     @db.Text
  errorMessage   String?      @db.Text
  durationMs     Int          @default(0)
  createdAt      DateTime     @default(now())

  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@map("notification_delivery_attempts")
}

model NotificationProviderCallback {
  id                 String   @id @default(uuid()) @db.Char(36)
  provider           String
  providerMessageId  String?
  status             String
  rawPayloadJson     String   @db.Text
  signatureVerified  Boolean  @default(true)
  receivedAt         DateTime @default(now())
  processedAt        DateTime?

  @@index([providerMessageId])
  @@map("notification_provider_callbacks")
}

model FinanceLedger {
  id              String   @id @default(uuid()) @db.Char(36)
  ledgerNumber    String   @unique
  transactionType String   // SALE, PAYMENT, COD_RECEIVED, WALLET_CREDIT, WALLET_DEBIT, REFERRAL_REWARD, REFUND, REFUND_REVERSAL, DELIVERY_CHARGE, PACKAGING_CHARGE, GST_OUTPUT, GST_INPUT, ADJUSTMENT, MANUAL_ENTRY
  referenceType   String?  // ORDER, REFUND, WALLET, SETTLEMENT, MANUAL
  referenceId     String?  @db.Char(36)
  customerId      String?  @db.Char(36)
  orderId         String?  @db.Char(36)
  storeId         String?  @db.Char(36)
  debit           Float    @default(0)
  credit          Float    @default(0)
  runningBalance  Float    @default(0)
  currency        String   @default("INR")
  narration       String?  @db.Text
  createdBy       String?
  createdAt       DateTime @default(now())

  @@index([createdAt])
  @@index([storeId])
  @@index([transactionType])
  @@index([customerId])
  @@index([orderId])
  @@map("finance_ledgers")
}

model WalletLedger {
  id              String   @id @default(uuid()) @db.Char(36)
  ledgerNumber    String   @unique
  customerId      String   @db.Char(36)
  transactionType String   // REFERRAL_CREDIT, REFUND_CREDIT, PROMOTIONAL_CREDIT, MANUAL_ADJUSTMENT, WALLET_USAGE, WALLET_EXPIRY, WALLET_REVERSAL
  amount          Float
  balanceAfter    Float
  referenceType   String?
  referenceId     String?  @db.Char(36)
  expiresAt       DateTime?
  narration       String?  @db.Text
  createdAt       DateTime @default(now())

  @@index([customerId])
  @@index([createdAt])
  @@map("wallet_ledgers")
}

model Settlement {
  id               String    @id @default(uuid()) @db.Char(36)
  settlementNumber String    @unique
  entityType       String    // STORE, RIDER, GATEWAY, WALLET
  entityId         String    @db.Char(36)
  amount           Float
  commission       Float     @default(0)
  netAmount        Float
  status           String    @default("PENDING") // PENDING, MATCHED, MISMATCH, RECONCILED, FAILED
  gatewayReference String?
  reconciledAt     DateTime?
  metadataJson     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([entityId])
  @@index([status])
  @@index([createdAt])
  @@map("settlements")
}

model ScheduledReport {
  id            String    @id @default(uuid()) @db.Char(36)
  reportType    String    // REVENUE, ORDERS, PRODUCTS, CUSTOMERS, PRODUCTION, DELIVERY, RETURNS, AUDIT
  frequency     String    // DAILY, WEEKLY, MONTHLY
  recipientEmail String
  storeId       String?   @db.Char(36)
  isActive      Boolean   @default(true)
  lastRunAt     DateTime?
  nextRunAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isActive])
  @@map("scheduled_reports")
}

model ReportExecution {
  id           String    @id @default(uuid()) @db.Char(36)
  reportType   String
  parameters   String?   @db.Text
  status       String    @default("SUCCESS") // SUCCESS, FAILED
  fileUrl      String?
  fileSize     Int?      @default(0)
  errorMessage String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([reportType])
  @@map("report_executions")
}

model ExportJob {
  id           String    @id @default(uuid()) @db.Char(36)
  exportType   String    // CSV, EXCEL, PDF
  module       String    // FINANCE, ORDERS, PRODUCTS, CUSTOMERS, GST
  status       String    @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  fileUrl      String?
  filterParams String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([status])
  @@map("export_jobs")
}

model AnalyticsSnapshot {
  id           String   @id @default(uuid()) @db.Char(36)
  snapshotDate String   @unique // YYYY-MM-DD
  metricsJson  String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([snapshotDate])
  @@map("analytics_snapshots")
}







  referralRelationshipId  String?  @db.Char(36)
  rewardTransactionId     String?  @db.Char(36)
  topUpId                 String?  @db.Char(36)
  transactionType         String // CREDIT, DEBIT
  direction               String   @default("CREDIT")
  amount                  Decimal  @db.Decimal(12, 2)
  currency                String   @default("INR")
  bucketType              String
  openingLotBalance       Decimal? @db.Decimal(12, 2)
  closingLotBalance       Decimal? @db.Decimal(12, 2)
  openingWalletBalance    Decimal? @db.Decimal(12, 2)
  closingWalletBalance    Decimal? @db.Decimal(12, 2)
  referenceType           String // TOP_UP, ORDER_PAYMENT, REWARD_CONVERSION, EXPIRY, REFUND, ADJUSTMENT
  referenceId             String?  @db.Char(36)
  reversalOfLedgerEntryId String?  @db.Char(36)
  status                  String   @default("COMPLETED")
  reasonCode              String?
  customerDescription     String?  @db.Text
  internalDescription     String?  @db.Text
  createdByType           String   @default("SYSTEM")
  createdById             String?  @db.Char(36)
  narration               String?  @db.Text
  metadataJson            String?  @db.Text
  idempotencyKey          String?  @unique
  createdAt               DateTime @default(now())


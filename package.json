{
  "name": "jaipur-gifting-enterprise",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx server/src/server.ts",
    "build": "prisma generate && vite build && esbuild server/src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "dev:client": "vite --port=5173",
    "dev:server": "tsx server/src/server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server/src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:studio": "prisma studio",
    "uploads:cleanup": "tsx server/src/scripts/cleanup.ts",
    "uploads:cleanup:dry-run": "tsx server/src/scripts/cleanup.ts --dry-run",
    "worker:notifications": "tsx server/src/workers/notification.worker.ts",
    "rewards:process-cooling": "tsx server/src/scripts/process-reward-jobs.ts --job=cooling",
    "rewards:auto-convert": "tsx server/src/scripts/process-reward-jobs.ts --job=autoconvert",
    "rewards:expire-wallet": "tsx server/src/scripts/process-reward-jobs.ts --job=expiry",
    "rewards:schedule-notifications": "tsx server/src/scripts/process-reward-jobs.ts --job=notify-schedule",
    "rewards:send-notifications": "tsx server/src/scripts/process-reward-jobs.ts --job=notify-send",
    "rewards:reconcile": "tsx server/src/scripts/process-reward-jobs.ts --job=reconcile",
    "rewards:run-all-due": "tsx server/src/scripts/process-reward-jobs.ts --job=all"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@hookform/resolvers": "^5.4.3",
    "@prisma/client": "^5.22.0",
    "@tailwindcss/vite": "^4.1.14",
    "@tanstack/react-query": "^5.101.4",
    "@types/leaflet": "^1.9.21",
    "@vitejs/plugin-react": "^5.0.4",
    "axios": "^1.18.1",
    "bcrypt": "^6.0.0",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.0",
    "firebase": "^12.16.0",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.546.0",
    "morgan": "^1.11.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.83.0",
    "react-is": "^19.2.8",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.21",
    "axios-mock-adapter": "^2.1.0",
    "esbuild": "^0.25.0",
    "jest": "^30.4.2",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "rollup": "4.14.3",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "rollup": "4.14.3"
  },
  "pnpm": {
    "overrides": {
      "rollup": "4.14.3"
    }
  },
  "resolutions": {
    "rollup": "4.14.3"
  }
}

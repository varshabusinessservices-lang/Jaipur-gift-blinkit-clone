    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-hook-form": "^7.83.0",
    "react-router-dom": "^7.18.1",
    "recharts": "^3.10.1",

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

DATABASE_URL=mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME

CLIENT_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=info
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

APP_NAME="Jaipur Personalised Gifts"
APP_TIMEZONE=Asia/Kolkata
APP_CURRENCY=INR
DEFAULT_STORE_MODE=SINGLE_STORE
CATEGORY_MAX_DEPTH=6

# Razorpay & Payment Gateway Configuration
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_ID=
PAYMENT_GATEWAY_MODE=auto
PAYMENT_ENVIRONMENT=sandbox
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300
PAYMENT_RECONCILIATION_ENABLED=true
WALLET_TOPUP_ENABLED=true
WALLET_TOPUP_MIN_AMOUNT=100
WALLET_TOPUP_MAX_AMOUNT=5000
WALLET_TOPUP_MAX_DAILY_AMOUNT=10000
WALLET_TOPUP_MAX_MONTHLY_AMOUNT=25000
WALLET_MAX_BALANCE=20000

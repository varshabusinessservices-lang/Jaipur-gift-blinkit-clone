VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME="Jaipur Personalised Gifts"
VITE_APP_ENV=development
VITE_ADMIN_USE_MOCK_API=true

# Category Configuration
CATEGORY_MAX_DEPTH=6

# Product Configuration
PRODUCT_MAX_VARIATION_COMBINATIONS=100
ATTRIBUTE_CATEGORY_INHERITANCE=true
PRODUCT_MAX_GALLERY_IMAGES=6
PRODUCT_IMAGE_MAX_SIZE_MB=8
PRODUCT_IMAGE_MIN_WIDTH=800
PRODUCT_IMAGE_MIN_HEIGHT=800
PRODUCT_VARIATION_AUTO_SKU=true
PRODUCT_VARIATION_MAX_GALLERY_IMAGES=4
PRODUCT_ACTIVE_VARIATION_REQUIRED=true

# Add-on Configuration
ADDON_CATEGORY_INHERITANCE=true
ADDON_IMAGE_MAX_SIZE_MB=3
ADDON_CUSTOMER_UPLOAD_MAX_SIZE_MB=10
ADDON_MULTI_IMAGE_MAX_COUNT=10

ADMIN_OTP_EXPIRY_MINUTES=10
ADMIN_OTP_RESEND_SECONDS=60
ADMIN_OTP_MAX_ATTEMPTS=5
DEV_SHOW_OTP=false

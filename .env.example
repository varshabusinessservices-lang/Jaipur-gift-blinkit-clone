VITE_API_BASE_URL=http://localhost:3000/api/v1
VITE_APP_NAME="Jaipur Personalised Gifts"
VITE_APP_ENV=development
VITE_ADMIN_USE_MOCK_API=true

# Server & Database Configuration
PORT=3000
NODE_ENV=development
DATABASE_URL="mysql://root:password@localhost:3306/jaipur_gifts"

# Category Configuration
CATEGORY_MAX_DEPTH=6

# Product Configuration
PRODUCT_MAX_VARIATION_COMBINATIONS=100
ATTRIBUTE_CATEGORY_INHERITANCE=true
PRODUCT_MAX_GALLERY_IMAGES=6
PRODUCT_IMAGE_MAX_SIZE_MB=8
PRODUCT_IMAGE_MIN_WIDTH=800
PRODUCT_IMAGE_MIN_HEIGHT=800
PRODUCT_VARIATION_AUTO_SKU=true
PRODUCT_VARIATION_MAX_GALLERY_IMAGES=4
PRODUCT_ACTIVE_VARIATION_REQUIRED=true

# Add-on Configuration
ADDON_CATEGORY_INHERITANCE=true
ADDON_IMAGE_MAX_SIZE_MB=3
ADDON_CUSTOMER_UPLOAD_MAX_SIZE_MB=10
ADDON_MULTI_IMAGE_MAX_COUNT=10

ADMIN_OTP_EXPIRY_MINUTES=10
ADMIN_OTP_RESEND_SECONDS=60
ADMIN_OTP_MAX_ATTEMPTS=5
DEV_SHOW_OTP=false

# Batch 13 Configuration
CUSTOMER_UPLOAD_SECRET=CHANGE_ME
ALLOW_JSON_STORAGE_FALLBACK=false

# Batch 14 Configuration
CUSTOMER_AUTH_MOBILE_OTP_ENABLED=true
CUSTOMER_AUTH_EMAIL_PASSWORD_ENABLED=false
CUSTOMER_OTP_PROVIDER=mock
CUSTOMER_OTP_ALLOW_DEV_CODE=false
CUSTOMER_OTP_EXPIRY_MINUTES=5
CUSTOMER_OTP_MAX_ATTEMPTS=5
CUSTOMER_OTP_RESEND_COOLDOWN_SECONDS=60
CUSTOMER_OTP_MAX_RESENDS=5
CUSTOMER_OTP_LENGTH=6
CUSTOMER_ACCESS_TOKEN_EXPIRY_MINUTES=15
CUSTOMER_REFRESH_TOKEN_EXPIRY_DAYS=30
CUSTOMER_WALLET_NEGATIVE_BALANCE_ALLOWED=false
CUSTOMER_REFERRAL_ENABLED=true


# Firebase Frontend
VITE_FIREBASE_API_KEY=CHANGE_ME
VITE_FIREBASE_AUTH_DOMAIN=CHANGE_ME
VITE_FIREBASE_PROJECT_ID=CHANGE_ME
VITE_FIREBASE_STORAGE_BUCKET=CHANGE_ME
VITE_FIREBASE_MESSAGING_SENDER_ID=CHANGE_ME
VITE_FIREBASE_APP_ID=CHANGE_ME
VITE_FIREBASE_MEASUREMENT_ID=CHANGE_ME

# Firebase Server
FIREBASE_ADMIN_PROJECT_ID=CHANGE_ME
FIREBASE_ADMIN_CLIENT_EMAIL=CHANGE_ME
FIREBASE_ADMIN_PRIVATE_KEY=CHANGE_ME

# Authentication Settings
FIREBASE_PHONE_AUTH_ENABLED=false
AUTH_FIREBASE_AUDIENCE=CHANGE_ME
